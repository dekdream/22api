# Keep this file local; never commit the actual .env.
PORT=3000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000
# Railway injects DATABASE_URL when the Postgres service is linked.
DATABASE_URL=postgresql://user:password@host:5432/database
# Add the enclosed-cup S3-compatible credentials to the 22api service.
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Generate a long random value, e.g. `openssl rand -base64 48`
API_JWT_SECRET=replace-with-a-long-random-secret
# IANA timezone used to determine the attendance work date.
BUSINESS_TIME_ZONE=Asia/Bangkok
